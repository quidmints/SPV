# L1 contract deploy (deploy/deploy-l1.sh → evm/src/DeployL1_s.sol:Deploy).
# Copy to deploy/deploy.env and fill in. Never commit the filled file.

RPC_URL=https://ethereum-rpc.publicnode.com   # target L1 (or your node)
PRIVATE_KEY=0x...                              # deployer / owner key
# hopNode (the address allowed to call openChannel/settleSwapIn). Defaults to
# the deployer if unset; set to the hop's QUID_HOT_KEY address.
HOP_NODE_OPERATOR=0x...

# SPVGateway anchor: a recent confirmed Bitcoin header (NOT genesis for mainnet).
#   raw 80-byte header (hex) / its height (decimal) / cumulative work at it.
BTC_CHECKPOINT_HEADER=00...                    # 80 bytes
BTC_CHECKPOINT_HEIGHT=860000
BTC_CHECKPOINT_WORK=...

# VERIFY=1 to etherscan-verify (needs ETHERSCAN_L1). BROADCAST=1 to send (else dry-run).
