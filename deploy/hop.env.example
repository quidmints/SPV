# QU!D hop (deploy/run-hop.sh → quid-bridge-daemon). Copy to deploy/hop.env.
# Never commit the filled file.

# ── EVM ──
QUID_RPC_URL=https://ethereum-rpc.publicnode.com
QUID_CHAIN_ID=1
QUID_BTC_CHANNELS=0x...        # from deploy-l1.sh
QUID_BTC_VAULT=0x...           # from deploy-l1.sh
QUID_SPV_GATEWAY=0x...         # from deploy-l1.sh
QUID_HOT_KEY=...               # 32-byte secp256k1 key; its addr MUST equal on-chain hopNode
QUID_START_BLOCK=...           # L1 block to seed the log cursors

# ── Lightning / Bitcoin ──
QUID_NETWORK=mainnet           # mainnet|testnet|regtest|signet
# QUID_SEED is OPTIONAL. Leave UNSET for born-in-enclave (seed generated inside
# SGX and sealed, never seen by the operator) — the production default. Set it
# ONLY for a guarded migration/recovery import. Once a sealed seed exists on
# disk it wins and QUID_SEED is ignored.
#QUID_SEED=...                 # 32-byte hop root seed (hex) — guarded import only
# Optional attested-provisioning / migration modes (see deploy/PRODUCTION-LAUNCH.md):
#QUID_PROVISION_LISTEN=127.0.0.1:9999        # serve attested /provision (operator-private addr)
#QUID_PROVISION_TOKEN=...                     # operator secret (openssl rand -hex 32) gating provisioning/migration
#QUID_MIGRATE_TO=host:port                    # transfer seed to a successor enclave, then exit
#QUID_MIGRATE_AUTH=/path/bundle.bin           # 2-of-3 operator-signed authorization (quid-migrate-auth --sign/--combine); names the successor MRENCLAVE host-unforgeably
QUID_ESPLORA_URL=https://blockstream.info/api
QUID_DATA_DIR=/var/lib/quid-hop
QUID_LSP_NODE_PK=02...         # the hop's LP counterparty node pubkey (33-byte)
QUID_LSP_ADDR=host:port        # LP p2p addr

# ── Optional (sane defaults) ──
# QUID_MIN_CONFIRMATIONS=6  QUID_GAS_LIMIT=400000  QUID_LP_FEE_RATE_SAT_VB=5
# QUID_CHANNEL_RECONCILE_SECS=300  QUID_MAX_FEE_PER_GAS=50000000000
# Swap-in HTTP ingress (both to enable): QUID_SWAPIN_LISTEN=0.0.0.0:8080 QUID_SWAPIN_API_TOKEN=...
