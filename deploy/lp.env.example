# QU!D liquidity provider (deploy/run-lp.sh → quid-lp-daemon). Copy to
# deploy/lp.env. Never commit the filled file.

QUID_NETWORK=mainnet
QUID_SEED=...                  # 32-byte LP node root seed (hex)
QUID_ESPLORA_URL=https://blockstream.info/api
QUID_DATA_DIR=/var/lib/quid-lp

# The HOP this LP serves (its LN node identity + p2p address).
QUID_LSP_NODE_PK=02...         # the hop's node pubkey (33-byte compressed)
QUID_LSP_ADDR=host:port

# EVM identity of the LP's BTC position (recovers from lpAuth → lpEth). This key
# ONLY signs the off-chain lpAuth digest; it never sends EVM txs.
QUID_CHAIN_ID=1
QUID_BTC_CHANNELS=0x...        # same BTCChannels the hop uses
QUID_LP_EVM_KEY=...            # 32-byte secp256k1 key (hex)

# Optional: open a channel of this many sats to the hop on boot (the LP's
# on-chain wallet must hold UTXOs to fund it).
# QUID_LP_CHANNEL_SATS=8000000
