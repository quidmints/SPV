diff --git a/evm/src/imports/BasketLib.sol b/evm/src/imports/BasketLib.sol
index ed2ce50..b35eb8b 100644
--- a/evm/src/imports/BasketLib.sol
+++ b/evm/src/imports/BasketLib.sol
@@ -981,7 +981,24 @@ library BasketLib {
         // haircut stables EXCEPT what is committed to the BTC band (an ETH-side redemption cannot
         // unwind the BTC band). Conservative: subtract POOLED_USD_BTC (>= BTC-band equity; ignores
         // the debt that would only shrink it), so the quote never over-reports.
-        uint btcCommitted = ICore(core).POOLED_USD_BTC() * 1e12;
+        // §UNIT-A / §E5 — NET EVERY LP CLAIM, NOT JUST THE CURVE MIRROR. §E5 routed the retained
+        // skew premium into `USD_FEES_BTC`, an LP liability, while leaving those dollars inside
+        // `total` — so they were owed to LPs AND quoted as QU!D redeemability (§E42 measured the
+        // quote rising $6.000099 on pure BTC trading, which must be invariant).
+        // ⚠️ `USD_FEES_BTC` IS A PER-SHARE ACCUMULATOR, NOT A DOLLAR TOTAL: SwapLib:1392 credits
+        // `mulDiv(usd6, WAD, shares)`. Subtracting it as dollars drove redeemable to exactly 0
+        // (measured). Undo the scaling with the SAME share base the credit site uses
+        // (Vault:640 `lpSharesBTC + totalBufferBTC`) to recover usd6.
+        // Reached via Aux's own `ethVenue` (the merged ETH+BTC Vault), NOT through Core, which has
+        // 38 bytes of EIP-170 margin left.
+        address bv = IAux(address(this)).ethVenue();
+        uint feesOwed6;
+        if (bv != address(0)) {
+            uint sharesBtc = IEthVenue(bv).lpSharesBTC() + IEthVenue(bv).totalBufferBTC();
+            if (sharesBtc > 0) feesOwed6 = FullMath.mulDiv(
+                IEthVenue(bv).USD_FEES_BTC(), sharesBtc, WAD);
+        }
+        uint btcCommitted = (ICore(core).POOLED_USD_BTC() + feesOwed6) * 1e12;
         return total > btcCommitted ? total - btcCommitted : 0;
     }
 
