# QU!D indexer config — copy to `.env` and fill in post-deploy.
# (The process reads real env vars; this file documents them. Load it however
#  you prefer, e.g. `set -a; . ./.env; set +a; npm start`.)

RPC_URL=http://127.0.0.1:8545

# Protocol addresses — fill in post-deploy of SPV/evm/ (mirror chains.ts).
QUID_BASKET=0x0000000000000000000000000000000000000000
QUID_AUX=0x0000000000000000000000000000000000000000
QUID_VOGUE=0x0000000000000000000000000000000000000000
QUID_BTC_CHANNELS=0x0000000000000000000000000000000000000000
# QUID_WETH defaults to canonical mainnet WETH; override only if needed.
# QUID_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# Set to the protocol deploy block (backfilling from genesis is impractical).
START_BLOCK=0

CONFIRMATIONS=12
CHUNK_SIZE=2000
POLL_MS=12000
PORT=4000
DB_PATH=./quid-index.db
